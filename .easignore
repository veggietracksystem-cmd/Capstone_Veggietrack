# EAS uploads from this repository root. Preserve the existing Git exclusions.
node_modules/
**/node_modules/
**/.env
**/.env*.local
**/.expo/
**/web-build/
.DS_Store
Thumbs.db
.claude/

# Local Android state contains absolute paths and must be regenerated on EAS.
**/android/build/
**/android/app/build/
**/android/.gradle/
**/android/.kotlin/
**/android/**/.cxx/
**/android/.idea/
**/android/local.properties
**/android/*.iml
**/android/*.hprof
**/android/app/src/main/java/inline/
**/android/**/*.jsbundle

# Separate scratch Expo project; mobile is the app built by this repository.
/VeggieTrack-Clean/

# Not needed to build the mobile app. EAS archives from the repository root,
# so these would otherwise upload on every build (~124 MB, ~11 minutes).
# Metro is rooted at mobile/ and nothing in mobile/src imports from backend/.
/backend/
/docs/
/mobile/dist/

# Web export/verification output, not used by the native build.
/mobile/.expo-web-build/
/mobile/.expo-verify-out/
