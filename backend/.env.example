# Copy to .env and fill in real values. NEVER commit the real .env.
PORT=3000
NODE_ENV=development

# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# Server-only Supabase HTTP Send SMS Hook and PhilSMS configuration
SEND_SMS_HOOK_SECRET=v1,whsec_replace_with_dashboard_signing_secret
PHILSMS_API_TOKEN=replace_with_private_philsms_api_token
PHILSMS_SENDER_ID=replace_with_approved_sender_id
# Keep false until you explicitly intend to send paid SMS.
PHILSMS_DELIVERY_ENABLED=false
# Public Cloudinary cloud name, matching mobile's CLOUDINARY_CLOUD_NAME.
# Required for profile photo URL validation; never put a Cloudinary secret in mobile.
CLOUDINARY_CLOUD_NAME=your_cloud_name
