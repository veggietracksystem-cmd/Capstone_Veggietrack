# Copy to .env and fill in real values. NEVER commit the real .env.
PORT=3000
NODE_ENV=development

# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Free Philippine SMS API (https://sms-api-ph.netlify.app)
SMS_API_PH_KEY=your_sms_api_ph_key

