# Copy to .env and fill in real values. NEVER commit the real .env.
PORT=3000
NODE_ENV=development

# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# Public Cloudinary cloud name, matching mobile's CLOUDINARY_CLOUD_NAME.
# Required for profile photo URL validation; never put a Cloudinary secret in mobile.
CLOUDINARY_CLOUD_NAME=your_cloud_name
