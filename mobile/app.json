{
  "expo": {
    "name": "VeggieTrack",
    "slug": "veggietrack",
    "scheme": "veggietrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "veggietrack.com"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow VeggieTrack to verify your delivery location."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow VeggieTrack to capture delivery proof.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "83724f9b-71a3-49fa-8189-7344e2ab5b3c"
      }
    },
    "owner": "angelo1263"
  }
}
