# Copy to .env and fill in real values. NEVER commit the real .env.
# Use your deployed HTTPS backend URL (see Render deploy guide). For local LAN
# testing you may use http://YOUR_LAN_IP:3000.
BACKEND_URL=https://your-backend.onrender.com

# Cloudinary (unsigned upload preset)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Optional registered Apple identifier.
IOS_BUNDLE_IDENTIFIER=
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
